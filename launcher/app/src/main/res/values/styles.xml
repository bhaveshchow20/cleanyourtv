<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- tvOS 27 App library: it zooms up over Home and shrinks back into it (design_language tvos27). -->
    <style name="TvosLibraryWindow">
        <item name="android:windowEnterAnimation">@anim/tvos_open_enter</item>
        <item name="android:windowExitAnimation">@anim/tvos_close_exit</item>
    </style>
    <!-- tvos27 Home: the window's shadow strength. Android's default spot shadow is too faint to lift a focused
         card off a TV picture; applied over the activity theme in MainActivity, so other themes keep theirs. -->
    <style name="TvosLighting">
        <item name="android:spotShadowAlpha">0.5</item>
        <item name="android:ambientShadowAlpha">0.16</item>
    </style>
</resources>
