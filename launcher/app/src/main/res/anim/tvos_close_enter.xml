<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 27: the screen behind comes back to size as the top one closes (TvMotion.close). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/tvos_ease_out"
    android:duration="220">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="1.04" android:toXScale="1"
        android:fromYScale="1.04" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
