<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 27: Home recedes and dims behind a screen opened from it (TvMotion.open). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/tvos_ease_out"
    android:zAdjustment="bottom"
    android:duration="320">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:toXScale="1.04"
        android:fromYScale="1" android:toYScale="1.04"
        android:pivotX="50%" android:pivotY="50%" />
</set>
