<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 27: a screen opened from a focused item zooms up into place (TvMotion.open). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/tvos_ease_out"
    android:duration="320">
    <alpha android:fromAlpha="0" android:toAlpha="1" />
    <scale android:fromXScale="0.92" android:toXScale="1"
        android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
</set>
