<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 27: a closing screen shrinks back towards the item it came from and fades (TvMotion.close). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/tvos_ease_out"
    android:zAdjustment="top"
    android:duration="220">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:toXScale="0.92"
        android:fromYScale="1" android:toYScale="0.92"
        android:pivotX="50%" android:pivotY="50%" />
</set>
